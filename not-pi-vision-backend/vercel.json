{
  "version": 2,
  "builds": [
    { 
      "src": "server.js",
      "use": "@vercel/node",
      "config": { "engine": "18.x" }
    },
    { 
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/server.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/server.js" }
  ]
}
