{
  "version": 2,
  "builds": [
    { 
      "src": "server.js",
      "use": "@vercel/node",
      "config": { 
        "engine": "18.x"
      }
    },
    { 
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { 
      "src": "/api/(.*)",
      "methods": ["POST", "GET"],
      "dest": "server.js"
    },
    {
      "src": "/favicon.ico",
      "dest": "public/favicon.ico"
    },
    {
      "src": "/static/(.*)",
      "dest": "public/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "public/$1"
    }
  ]
}
